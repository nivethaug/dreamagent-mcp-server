# DreamAgent account to connect (required)
DREAMAGENT_EMAIL=you@example.com
DREAMAGENT_PASSWORD=your-dreamagent-password

# API base (optional — default is production)
# DREAMAGENT_API_URL=https://api.dreamagent.cloud

# HTTP transport options (only used with --http)
# MCP_HOST=127.0.0.1
# MCP_PORT=8800

# LOG_LEVEL=INFO
